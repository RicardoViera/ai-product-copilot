// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  name      String?
  createdAt DateTime @default(now())

  products  Product[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  messages    Message[]
  docs        ProductDoc[]
  docChunks   ProductDocChunk[]
  createdAt   DateTime  @default(now())
}

model Message {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  role       String   // 'user' or 'assistant'
  content    String
  createdAt  DateTime @default(now())
}

model ProductDoc {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  title     String
  content   String?  // extracted text (we'll fill from uploaded file)
  filePath  String   // storage path in bucket
  fileName  String
  mimeType  String
  chunks    ProductDocChunk[]
  isIndexed Boolean @default(false)

  createdAt DateTime @default(now())
}

model ProductDocChunk {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  docId      String
  doc        ProductDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  content    String
  embedding  Unsupported("vector(1536)") // pgvector

  createdAt  DateTime @default(now())
}

